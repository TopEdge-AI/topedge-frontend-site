# Public marketing site ONLY.
# Do NOT put RAZORPAY_SAAS_KEY_SECRET, webhook secrets, or plan_ ids here.
# Those belong on api.topedgeai.com (chatbot-backend), never Netlify.

NEXT_PUBLIC_SITE_URL=https://www.topedgeai.com
NEXT_PUBLIC_DASH_URL=https://dash.topedgeai.com
NEXT_PUBLIC_API_URL=https://api.topedgeai.com
NEXT_PUBLIC_BILLING_CATALOG_URL=https://api.topedgeai.com/api/billing/catalog

VITE_SITE_URL=https://www.topedgeai.com
VITE_DASH_URL=https://dash.topedgeai.com
VITE_API_URL=https://api.topedgeai.com
VITE_BILLING_CATALOG_URL=https://api.topedgeai.com/api/billing/catalog

NEXT_PUBLIC_SITE_URL=https://www.topedgeai.com
NEXT_PUBLIC_DASH_URL=https://dash.topedgeai.com
NEXT_PUBLIC_API_URL=https://api.topedgeai.com
NEXT_PUBLIC_BILLING_CATALOG_URL=https://api.topedgeai.com/api/billing/catalog

# Vite aliases (this repo is Vite, not Next)
VITE_SITE_URL=https://www.topedgeai.com
VITE_DASH_URL=https://dash.topedgeai.com
VITE_API_URL=https://api.topedgeai.com
VITE_BILLING_CATALOG_URL=https://api.topedgeai.com/api/billing/catalog

# Google Analytics 4 (optional). Leave empty to keep analytics off.
# Set to your measurement id, e.g. G-XXXXXXXXXX, in Netlify env vars to turn it on.
#
# The live property for topedgeai.com is G-Y8Z47DNJ6V. It is recorded here
# because a GA4 measurement id is public (it ships in the page source), it is
# not a credential, and .env is gitignored, so otherwise the only copy lives in
# one person's Netlify dashboard. Set it there; the build reads it at build
# time, so changing it needs a redeploy.
#
# Do NOT paste Google's gtag.js snippet into index.html. src/marketing/lib/
# analytics.ts already loads gtag after the window load event, sends SPA page
# views, and applies region-scoped consent defaults. A second copy in the head
# would double-load the tag, double-count page views and bypass that consent
# logic.
VITE_GA_MEASUREMENT_ID=

# Google Ads (optional). Leave empty to keep ad tagging off.
# VITE_GOOGLE_ADS_ID is the account tag (Google Ads > Admin > Google tag). It is what
# builds the remarketing audience — without it there is no retargeting list, ever.
VITE_GOOGLE_ADS_ID=
# Conversion label for the "reached signup" action (Goals > Conversions > the action
# > Tag setup > the `send_to` value after the slash). Secondary conversion only:
# the account is created on dash.topedgeai.com, not here.
# The LANDING PAGE's conversion label: "clicked through to signup".
# This must be a DIFFERENT Google Ads conversion action from the dashboard's
# account-created one, or every CTA click is reported as a real signup.
VITE_GOOGLE_ADS_LP_CTA_LABEL=

# PostHog (optional). Leave empty to keep it off.
# Per-person journeys and automatic button/link capture on the MARKETING SITE only.
# Deliberately not added to the dashboard: that app holds merchants' customer
# conversations and already has its own consent-gated first-party telemetry.
# Project key from PostHog > Settings > Project > Project API Key (starts phc_).
VITE_POSTHOG_KEY=
# Only needed for an EU project: https://eu.i.posthog.com
VITE_POSTHOG_HOST=
